{
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"[typescript][typescriptreact][json][markdown][toml][yaml]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[lua][luau]": {
		"editor.defaultFormatter": "JohnnyMorganz.stylua"
	},
	"liveshare.languages.allowGuestCommandControl": true,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"default.project.json": "flamework.build",
		"stylua.toml": ".styluaignore",
		"package.json": "bun.lock",
		"asphalt.toml": "asphalt.lock.toml",
		"selene.toml": "selene-std.yaml",
		".luaurc": "sourcemap.json",
		"*.d.ts": "${capture}.luau"
	},
	"liveshare.allowGuestTaskControl": true,
	"liveshare.focusBehavior": "prompt",
	"liveshare.launcherClient": "visualStudioCode",
	"liveshare.publishWorkspaceInfo": true,
	"[typescriptreact]": {
		"editor.defaultFormatter": "dprint.dprint"
	}
}
